# Documentation template only. The CLI does NOT automatically load .env files.
# Set these through your shell or a local secret manager. Never commit real values.
# TYPESAFE_API_KEY=
# S1_TEACHER_MODEL=provider/actual-model-identifier
# Set the corresponding provider-native API key variable locally.
# Optional custom teacher endpoint and credential:
# S1_TEACHER_API_BASE=
# S1_TEACHER_API_KEY=
# Optional SDK-native target endpoint override; validate before sending data:
# TYPESAFE_BASE_URL=
